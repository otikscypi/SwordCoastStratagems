
@1105 = ~Dziwne... wyczuwam coś...~
@1106 = ~Jestem sługą bogów. Nie ukryjesz się.~
@1107 = ~Poprzez nadaną mi moc, rozkazuję ci ukaż się!~
@1108 = ~Dziwne... zobaczmy, co małe poznanie może ukazać...~
@4300 = ~Uzrith~
@4301 = ~Chlimbia~
@4302 = ~Irithlin~
@4303 = ~Kto wzywa Uzritha, Księcia Ziemi?~
@4304 = ~Kto wzywa Chlimbia, Księcia Ognia?~
@4305 = ~Kto wzywa Irithlina, Księcia Powietrza?~
@4307 = ~Kto wzywa Alyolvoya, Księcia Wody?~

@5000="Ufam Pani!"
@5001="Tymoro, chroń mnie!"
@5002="Uśmiechnij się do mnie, Tymoro!"

@5010="Na Tempusa!"
@5011="Dla Pana Bitwy!"
@5012="Tempusie, pobłogosław tę walkę!"

@5020="Za Czarne Słońce!"
@5021="Niech spłynie na Ciebie klątwa Cyrica!"

@5030="Niech Bane zmiażdży Cię w swej dłoni!"
@5031="W imię Pana Ciemności!"

@5040="Dla Boskiego Syna! Dla Xvima!"
@5041="Doświadcz gniewu Iyachtu Xvima!"
@5042="Synu Bane'a, zmiażdż moich wrogów!"

@5050="Płoń w ogniu Kossutha!"
@5051="Panie płomieni, spal mych wrogów!"
@5052="Niech gniew Władcy Ognia Cię pochłonie!"

@5060="Helm mnie ochroni!"
@5061="W imię Helma!"
@5062="Dla Strażnika!"

@5070="Dla Pana Poranka!"
@5071="Dla Lathandera!"
@5072="Na światło poranka!"

@5080="Dla Pana Burz!"
@5081="Dla Talosa!"
@5082="Posmakuj gniewu Talosa!"

@5090="Niech Talona przeklnie Cię!"
@5091="W imię Matki Wszelkich Plag!"

@5100="Poczuj lodowy pocałunek Auril!"
@5101="Niech Auril zmrozi Twoją krew!"
@5102="Za Lodową Dziewicę!"

@5110="Posmakuj wściekłości Malara!"
@5111="Dla Władcy Bestii!"
@5112="Malarze, poluję w Twoje imię!"

@5120="Wesprzyj mnie , Władco Cieni!"
@5121="W imie Maski, uderzam!"

@5130="Dla Srebrnej Pani!"
@5131="Selûne, obdarz mnie są łaską!"
@5132="W imię Księżycowej Dziewicy!"

@5140="Niech ciemność Shar Cię oślepi!"
@5141="Dla Pieśniarki Nocy!"

@5150="Niech Umberlee Cię przeklnie!"
@5151="Utop się we gniewie Umberlee!"
@5152="Na Boginię Mórz!"

@5160="Przynoszę Ci sprawiedliwość Tyra!"
@5161="Tyrze, prowadź mnie!"
@5162="Za Tyra Sprawiedliwego!"
@5163="W imię Tyra!"

@5170="Ilmaterze, pozwól mi wytrwać!"
@5171="Płaczący Bóg mnie obroni!"

@5180="Pan Kości Cię weźmie..."
@5181="Poczuj dotyk Myrkula i umrzyj..."
